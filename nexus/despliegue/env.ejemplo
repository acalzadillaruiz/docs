# Copiar a `.env` en esta misma carpeta y rellenar. `.env` NO va al repositorio.
#
#   cp env.ejemplo .env && nano .env

# El dominio, sin https:// delante. Su DNS tiene que apuntar ya a este servidor.
DOMINIO=nexus.grupoprimesupply.com

# La clave de la base de datos. No la elijas a mano: sácala de aquí.
#   openssl rand -base64 32
BD_CLAVE=

# La cuenta con la que el servidor consulta la base. La imprime `instalar.ts` la
# primera vez; hasta entonces, déjala como está y arranca solo la base y el esquema.
PERSONA_SERVICIO=

# ---------------------------------------------------------------- opcional
# Correo. Sin esto los avisos se escriben en el registro en vez de enviarse, y todo lo
# demás funciona igual.
SMTP=
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=avisos@grupoprimesupply.com

# Entrada con la cuenta de Microsoft o de Google. Sin esto, esa opción no se ofrece y se
# entra con clave y código, que es lo que ya funciona.
MS_CLIENTE=
MS_SECRETO=
GOOGLE_CLIENTE=
GOOGLE_SECRETO=
